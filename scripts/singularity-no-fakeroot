#!/bin/bash
# Transparent `singularity` shim that makes harbor's Terminal-Bench containers work here.
#
# harbor's singularity backend starts every container with
#     singularity exec --writable-tmpfs --fakeroot --containall --pid ... \
#         bash -c 'exec /staging/bootstrap.sh "$@"' bash <workdir> ...
# (harbor/environments/singularity/singularity.py, _start_server). Two things about that are
# wrong for this cluster, and this shim fixes both without patching the installed harbor.
#
# 1. --fakeroot is fatal. It selects the unprivileged user-namespace path, which mounts the SIF
#    with squashfuse -o allow_other -- refused, because /etc/fuse.conf leaves user_allow_other
#    commented out -- and then falls back to extracting the SIF, which wants an /etc/subuid
#    mapping this account does not have:
#        FATAL: could not use fakeroot: no mapping entry found in /etc/subuid for u4320956
#    So the flag is dropped.
#
# 2. Dropping it alone is not enough. singularity-ce 4.1.2 here is setuid, so the container then
#    starts -- but as the invoking user, and --writable-tmpfs overlays a tmpfs whose lower layer
#    still says /opt is root:root 755, so harbor's bootstrap cannot create its server venv.
#    `unshare -r` maps this uid to 0 in an unprivileged user namespace (verified available:
#    max_user_namespaces = 15076), and singularity then extracts the SIF to a sandbox it owns,
#    giving a root-owned writable root filesystem. The cost is extraction instead of a loop
#    mount at every container start, so SINGULARITY_TMPDIR must point at node-local /tmp.
#
# Being uid 0 by namespace rather than for real then breaks several things INSIDE the container
# -- apt, dpkg, su, and bootstrap's python probe. Those are repaired by
# scripts/harbor-container-prelude.sh, which this shim bind-mounts in and sources just before
# handing control to harbor's bootstrap. Each repair there is tied to an observed failure.
#
# Everything else is passed through untouched. Put this directory first on PATH as `singularity`.
set -u

SELF=$(readlink -f "${BASH_SOURCE[0]}")
PRELUDE_SRC=$(dirname "$SELF")/harbor-container-prelude.sh
BOOTSTRAP='exec /staging/bootstrap.sh "$@"'

# The prelude is carried INSIDE the command string, base64-encoded, rather than bind-mounted.
# A bind was the obvious approach and silently did not work: singularity skips a bind whose
# destination does not exist in the image, without failing, so the container came up with the
# prelude absent and the same in-container errors as before -- indistinguishable from the
# prelude running and not helping. Encoding it removes the failure mode entirely.
PRELUDE_CMD=""
if [[ -f "$PRELUDE_SRC" ]]; then
    _b64=$(base64 -w0 < "$PRELUDE_SRC" 2>/dev/null || base64 < "$PRELUDE_SRC" | tr -d '\n')
    PRELUDE_CMD="printf %s '$_b64' | base64 -d > /harbor-prelude.sh 2>/dev/null; . /harbor-prelude.sh 2>/dev/null; "
fi

args=()
for a in "$@"; do
    case "$a" in
        --fakeroot|-f)
            continue                        # see (1)
            ;;
        "$BOOTSTRAP")
            # Apply the repairs in the same shell, then hand over to harbor unchanged.
            args+=("${PRELUDE_CMD}${BOOTSTRAP}")
            continue
            ;;
    esac
    args+=("$a")
done

# Already root (a real root, or an outer userns someone else set up): nothing to map.
if [[ "$(id -u)" == "0" ]]; then
    exec /usr/bin/singularity "${args[@]}"
fi

if command -v unshare > /dev/null 2>&1 && unshare -r true 2>/dev/null; then
    exec unshare -r /usr/bin/singularity "${args[@]}"
fi

# No user namespaces available: still better to try than to pass --fakeroot, which cannot work.
echo "singularity-no-fakeroot: unshare -r unavailable, running unprivileged" >&2
exec /usr/bin/singularity "${args[@]}"
