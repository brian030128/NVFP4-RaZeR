#!/bin/bash
# Transparent `singularity` shim that makes harbor's container startup work on this cluster.
#
# harbor's singularity backend always starts the container with
#     singularity exec --writable-tmpfs --fakeroot --containall --pid ...
# (harbor/environments/singularity/singularity.py, _start_server). Both of those privilege
# choices are wrong for this account, in different ways, and the shim fixes each:
#
# 1. --fakeroot is fatal. It selects the unprivileged user-namespace path, which then tries to
#    mount the SIF with squashfuse -o allow_other -- refused, because /etc/fuse.conf leaves
#    user_allow_other commented out -- and falls back to extracting the SIF, which wants an
#    /etc/subuid mapping this account does not have:
#        FATAL: could not use fakeroot: no mapping entry found in /etc/subuid for u4320956
#    So the flag is dropped.
#
# 2. Dropping it alone is not enough. singularity-ce 4.1.2 here is setuid, so without --fakeroot
#    the container starts -- but as the invoking user, and --writable-tmpfs overlays a tmpfs
#    whose lower layer still says /opt is root:root 755. harbor's bootstrap installs its server
#    venv into /opt/harbor-server, so it dies with "Permission denied" instead.
#
# The fix for (2) is `unshare -r`: an unprivileged user namespace that maps our uid to 0.
# Verified on this cluster (max_user_namespaces = 15076, no subuid needed):
#     unshare -r singularity exec --writable-tmpfs --containall --pid alpine.sif \
#         sh -c 'id -u; mkdir -p /opt/probe && echo write-ok > /opt/probe/f'
#     -> 0 / write-ok
# Inside that namespace singularity extracts the SIF to a sandbox it owns, so the container runs
# as root with a fully writable root filesystem -- which is what the task images expect.
#
# The cost is that each container start extracts the SIF rather than loop-mounting it: slower,
# and it needs room in SINGULARITY_TMPDIR (point that at node-local /tmp, never /home).
#
# Everything else is passed through untouched. Put this directory first on PATH as `singularity`.
set -u

args=()
for a in "$@"; do
    if [[ "$a" == "--fakeroot" || "$a" == "-f" ]]; then
        continue
    fi
    args+=("$a")
done

# 3. Two more things break INSIDE the container, both consequences of the user namespace, and
#    both are fixed by a prelude in front of harbor's bootstrap rather than by patching harbor.
#    Probed on a real task image (results/terminal_bench/probe_337478):
#
#    a. Task images are Debian with python at /usr/local/bin/python3 and no /usr/bin/python3.
#       bootstrap.sh tests that exact path, so it declares python missing and tries to install
#       it. Symlinking the interpreter the image already ships satisfies it -- verified:
#       "symlinked /usr/bin/python3 -> /usr/local/bin/python3 / venv ok / ensurepip ok".
#
#    b. apt-get cannot run: it drops privileges to the _apt user, which a single-mapping userns
#       forbids, so every fetch dies and the package lists never refresh --
#           E: seteuid 42 failed / setgroups 0 failed / Unable to locate package python3
#       Telling apt to stay root (APT::Sandbox::User "root") is the standard fix, and it also
#       lets bootstrap.sh install the tmux these images lack and terminal agents need.
BOOTSTRAP='exec /staging/bootstrap.sh "$@"'
PRELUDE='mkdir -p /etc/apt/apt.conf.d 2>/dev/null && printf "APT::Sandbox::User \"root\";\n" > /etc/apt/apt.conf.d/99-harbor-userns 2>/dev/null; [ -x /usr/bin/python3 ] || { p=$(command -v python3 2>/dev/null); [ -n "$p" ] && ln -sf "$p" /usr/bin/python3 2>/dev/null; }; '
for i in "${!args[@]}"; do
    if [[ "${args[$i]}" == "$BOOTSTRAP" ]]; then
        args[$i]="${PRELUDE}${BOOTSTRAP}"
    fi
done

# Already root (a real root, or an outer userns someone else set up): nothing to map.
if [[ "$(id -u)" == "0" ]]; then
    exec /usr/bin/singularity "${args[@]}"
fi

if command -v unshare > /dev/null 2>&1 && unshare -r true 2>/dev/null; then
    exec unshare -r /usr/bin/singularity "${args[@]}"
fi

# No user namespaces available: still better to try than to pass --fakeroot, which cannot work.
echo "singularity-no-fakeroot: unshare -r unavailable, running unprivileged" >&2
exec /usr/bin/singularity "${args[@]}"
