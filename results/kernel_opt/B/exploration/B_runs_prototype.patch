diff --git a/sm120/tests/test_runs.py b/sm120/tests/test_runs.py
new file mode 100644
index 0000000..61c316b
--- /dev/null
+++ b/sm120/tests/test_runs.py
@@ -0,0 +1,150 @@
+"""kernel-opt B: run-table builds (MIXFP4_RUNS) dispatch once per run of equal patterns along K.
+
+1. The run table (mixfp4_sm120/runs.py) equals a plain-loop reference and decodes back to the per-k_tile patterns; the
+   warp patterns follow the kernel's granule layout (G-span: warp w owns 16-row blocks w and w + 4 of a panel).
+2. With the table, every run-table build computes exactly what it computes without one (its per-k_tile dispatch) and
+   what the reference build computes (n16k64_wA or n16k64_wA_g32 from the reference build directory), bitwise: the
+   decode probe on single-tag and random maps, and random GEMMs over model and boundary shapes (partial row panels,
+   K not a multiple of 128) with every joint pattern present.
+3. NativeLinear on a run-table KernelSet builds the table and equals NativeLinear on the reference set on the fused,
+   reuse and unfused paths.
+"""
+import os
+from pathlib import Path
+
+import pytest
+import torch
+
+from mixfp4_sm120 import numerics as N
+from mixfp4_sm120 import runs as RT
+from mixfp4_sm120.artifact import pack_module
+from mixfp4_sm120.lib import Kernel
+from mixfp4_sm120.linear import NativeLinear, clear_quant_cache
+from mixfp4_sm120.select import KernelSet
+from test_gemm import SHAPES, identity_operand, linear_gemm, place, random_weight_operand
+
+pytestmark = pytest.mark.gpu
+
+REF_ROOT = Path(os.environ.get('SM120_REF_BUILD_DIR', Path(__file__).resolve().parents[1] / 'build'))
+REF_A1 = Path(os.environ.get('SM120_REF_A1_DIR', '/home/dev/n16k64_campaign/kernel_opt/build_A1'))
+RT16 = ['n16k64_wA_rt', 'n16k64_wA_rt_n64', 'n16k64_wA_rt_n32', 'n16k64_wA_rt_n16']
+RT32 = ['n16k64_wA_g32_rt', 'n16k64_wA_g32_rt_n64', 'n16k64_wA_g32_rt_n32', 'n16k64_wA_g32_rt_n16']
+
+
+def kernel(name):
+    try:
+        k = Kernel.load(name)
+    except Exception as e:  # noqa: BLE001
+        pytest.skip(f'{name} not built: {e}')
+    assert k.runs, name
+    return k
+
+
+def reference(name):
+    ref, root = ('n16k64_wA_g32', REF_A1) if '_g32' in name else ('n16k64_wA', REF_ROOT)
+    try:
+        return Kernel.load(ref + name.split('_rt')[1], build_root=root)
+    except Exception as e:  # noqa: BLE001
+        pytest.skip(f'reference {ref} not built in {root}: {e}')
+
+
+def random_map(name, n, k, g, frac):
+    """A random map the build executes: 16x64 tiles, or (g32) uniform over 128-row panels, stored as 16x64 granules."""
+    rows = 128 if '_g32' in name else 16
+    mask = torch.rand(-(-n // rows), k // 64, generator=g) < frac
+    return mask.repeat_interleave(rows // 16, 0)[:n // 16]
+
+
+def test_run_table_reference():
+    g = torch.Generator().manual_seed(0)
+    for panels, warps, k_tiles, dens in ((3, 4, 40, 0.1), (5, 4, 1, 0.5), (2, 4, 140, 0.3), (7, 4, 33, 0.0)):
+        pat = (torch.rand(panels, warps, k_tiles, generator=g) < dens).long() * torch.randint(1, 16, (panels, warps, k_tiles), generator=g)
+        table = RT.run_table(pat)
+        assert torch.equal(table, RT.reference_table(pat))
+        for i, row in enumerate(pat.reshape(-1, k_tiles).tolist()):
+            seq = []
+            for j in range(int(table[i, 0])):
+                e = int(table[i, 1 + j]) & 0xFFFF
+                seq += [e & 15] * (e >> 4)
+            assert seq == row
+
+
+def test_warp_patterns_layout():
+    n, k = 256, 256
+    f = torch.zeros(n // 16, k // 64, dtype=torch.bool)
+    f[1, 0] = True       # panel 0, block 1 = warp 1's m-atom 0, k_tile 0, k_block 0
+    f[12, 3] = True      # panel 1, block 4 = warp 0's m-atom 1, k_tile 1, k_block 1
+    p16 = RT.warp_patterns(f, n, k)
+    assert p16[0, 1].tolist() == [1, 0] and p16[1, 0].tolist() == [0, 8] and int(p16.sum()) == 9
+    p32 = RT.warp_patterns(f, n, k, a_atoms=2)       # a g32 granule takes its first m-atom's flag
+    assert p32[0, 1].tolist() == [1, 0] and int(p32.sum()) == 1
+
+
+@pytest.mark.parametrize('name', RT16 + RT32)
+@pytest.mark.parametrize('n,k', [(128, 128), (256, 512), (48, 256), (1024, 320), (4096, 192)])
+def test_decode_probe(device, name, n, k):
+    kern, ref = kernel(name), reference(name)
+    g = torch.Generator(device='cpu').manual_seed(n * 7 + k)
+    m16 = random_map(name, n, k, g, 0.4)
+    wnib, wsb = random_weight_operand(n, k, m16, (16, 64), seed=n + k)
+    table = RT.build(wsb, n, k, kern.runs_geometry).cuda()
+    got = {}
+    for label, kk, runs in (('runs', kern, table), ('no table', kern, None), ('reference', ref, None)):
+        out = torch.empty((n, k), dtype=torch.float64, device='cuda')
+        for off in range(0, k, 1024):
+            t = min(1024, k - off)
+            xnib, xsb = identity_operand(t, k, off)
+            d = kk.gemm(N.pack_nibbles(wnib), place(wsb, k), N.pack_nibbles(xnib), place(xsb, k), n, t, k, runs=runs)
+            out[:, off:off + t] = d.double().t()
+        got[label] = out
+    assert torch.equal(got['runs'], N.decode_exact(wnib, wsb, 1.0))
+    assert torch.equal(got['runs'], got['no table']) and torch.equal(got['runs'], got['reference'])
+
+
+@pytest.mark.parametrize('name', RT16 + RT32)
+@pytest.mark.parametrize('t,n,k', SHAPES)
+def test_random_gemm_bitwise(device, name, t, n, k):
+    kern, ref = kernel(name), reference(name)
+    g = torch.Generator(device='cpu').manual_seed(t * 31 + n + k)
+    m16 = random_map(name, n, k, g, 0.5)
+    w = (torch.randn(n, k, generator=g) * 0.02).cuda().bfloat16()
+    x = torch.randn(t, k, generator=g)
+    x[:, torch.randperm(k, generator=g)[:4]] *= 30
+    x = x.cuda().bfloat16()
+    wnib, wsb, gs_w = N.quantize_weight(w, 'map', m16, (16, 64))
+    xnib, xsb, gs_x = N.quantize_act(x, 'four_over_six_rows')
+    table = RT.build(wsb.cuda(), n, k, kern.runs_geometry)
+    args = (N.pack_nibbles(wnib), place(wsb, k), float(gs_w), N.pack_nibbles(xnib), place(xsb, k), gs_x, n, t, k)
+    a = kern.gemm(args[0], args[1], args[3], args[4], n, t, k, scale_m_default=args[2], scale_n=gs_x, runs=table)
+    b = linear_gemm(kern, *args)
+    c = linear_gemm(ref, *args)
+    assert torch.equal(a.view(torch.int16), b.view(torch.int16)), 'runs path differs from the per-k_tile path'
+    assert torch.equal(a.view(torch.int16), c.view(torch.int16)), 'runs path differs from the reference build'
+
+
+@pytest.mark.parametrize('family,ref_family,ref_root', [('mixed_rt', 'mixed', REF_ROOT), ('mixed256_rt', 'mixed256', REF_A1)])
+@pytest.mark.parametrize('t,n,k', [(1, 4096, 4096), (19, 1024, 4096), (300, 48, 2560), (77, 2560, 9728)])
+def test_native_linear_paths(device, family, ref_family, ref_root, t, n, k):
+    try:
+        ks = KernelSet(family)
+        rs = KernelSet(ref_family, build_root=ref_root)
+    except Exception as e:  # noqa: BLE001
+        pytest.skip(f'{family} or {ref_family} not built: {e}')
+    g = torch.Generator(device='cpu').manual_seed(t + n)
+    w = (torch.randn(n, k, generator=g) * 0.02).cuda().bfloat16()
+    bias = (torch.randn(n, generator=g) * 0.1).cuda().bfloat16()
+    m16 = random_map('_g32' if 'mixed256' in family else '', n, k, g, 0.3)
+    pw = pack_module('m', w, bias, 'map', m16, (16, 64))
+    x = torch.randn(t, k, generator=g).cuda().bfloat16()
+    lin, rlin = NativeLinear(pw, ks, 'four_over_six_rows', 'm'), NativeLinear(pw, rs, 'four_over_six_rows', 'm')
+    assert lin.runs is not None and rlin.runs is None
+    for fused, share in ((True, False), (True, True), (False, False)):
+        outs = []
+        for l_ in (lin, rlin):
+            clear_quant_cache()
+            l_.fused, l_.share_input = fused, share
+            y = l_(x)
+            if share:
+                y = l_(x)
+            outs.append(y)
+        assert torch.equal(outs[0].view(torch.int16), outs[1].view(torch.int16)), (fused, share)
