index 0000000..4a352bd
--- /dev/null
+++ b/sm120/mixfp4_sm120/runs.py
@@ -0,0 +1,92 @@
+"""kernel-opt B: per-warp run tables for the weights-on-A mixed kernels built with MIXFP4_RUNS.
+
+The mixed mainloop dispatches every k_tile on a pattern of E0M3 flags that each warp reads from its operands (bit
+g + a_gran * kb for granule g of the warp's m-atoms and k_block kb of the k_tile). With a run table it instead
+enters each run of equal patterns once and loops the unchanged k_tile body inside that arm (the collective's
+MIXFP4_RUNS hook). The table is built here, once per weight, from the same tags, so every k_tile still executes the
+MMAs of its own pattern.
+
+Geometry (all widths of the n16k64_wA family and of the 32-row-granule g32 builds share it; `Kernel.runs_geometry`):
+a CTA covers tile_m = 128 weight rows (one "panel"); warp row w of warps_m = 4 owns m-atoms m = 0 .. mma_m - 1 at the
+16-row blocks m * warps_m + w of the panel; a granule is a_atoms consecutive m-atoms and takes its first atom's flag;
+k_tiles are 128 wide (two 64-wide k_blocks). Rows past n and k_blocks past K read as E2M1 (the TMA zero fill).
+
+Table: int16 [panels * warps_m, stride], row p * warps_m + w: entry 0 = number of runs R, entries 1 .. R = pattern |
+run length << 4, in K order; the lengths sum to the number of k_tiles. stride = 1 + the largest R.
+"""
+import torch
+
+from . import numerics as N
+
+K_TILE = 128
+
+
+def block_flags(scales, n, k):
+    """bool [n/16 (rounded up), k/64]: the E0M3 tag of every 16-row x 64-column tile, from the tagged scale bytes
+    [n, k/16] (bit 7). The tag the kernel reads is the tile's first scale byte (tags are uniform over 16x64 tiles)."""
+    rows16 = -(-n // 16)
+    f = (scales[::16, ::64 // N.SCALE_BLOCK] >> 7).to(torch.bool)
+    assert tuple(f.shape) == (rows16, k // 64), (tuple(f.shape), n, k)
+    return f
+
+
+def warp_patterns(flags16, n, k, warps_m=4, mma_m=2, a_atoms=1, tile_m=128):
+    """int64 [panels, warps_m, k_tiles]: the joint pattern each warp's dispatch reads at each k_tile."""
+    blocks = tile_m // 16
+    assert blocks == warps_m * mma_m and mma_m % a_atoms == 0, (tile_m, warps_m, mma_m, a_atoms)
+    panels = -(-n // tile_m)
+    k_tiles = -(-k // K_TILE)
+    f = torch.zeros(panels * blocks, k_tiles * 2, dtype=torch.int64, device=flags16.device)
+    f[:flags16.shape[0], :flags16.shape[1]] = flags16.to(torch.int64)
+    f = f.view(panels, mma_m, warps_m, k_tiles, 2)             # 16-row block m * warps_m + w = m-atom m of warp row w
+    a_gran = mma_m // a_atoms
+    pat = torch.zeros(panels, warps_m, k_tiles, dtype=torch.int64, device=flags16.device)
+    for g in range(a_gran):
+        for kb in range(2):
+            pat |= f[:, g * a_atoms, :, :, kb] << (g + a_gran * kb)
+    return pat
+
+
+def run_table(pat):
+    """int16 [panels * warps_m, stride] run table (see the module docstring) of a warp_patterns tensor."""
+    panels, warps_m, k_tiles = pat.shape
+    if k_tiles >= 2048:
+        raise ValueError(f'{k_tiles} k_tiles: a run length needs more than 11 bits')
+    rows = pat.reshape(panels * warps_m, k_tiles)
+    start = torch.ones_like(rows, dtype=torch.bool)
+    start[:, 1:] = rows[:, 1:] != rows[:, :-1]
+    run_id = torch.cumsum(start.to(torch.int64), 1) - 1                     # [R, k_tiles]
+    nruns = start.sum(1)
+    length = torch.zeros_like(rows).scatter_add_(1, run_id, torch.ones_like(rows))
+    pattern = torch.zeros_like(rows).scatter_(1, run_id, rows)
+    stride = 1 + int(nruns.max())
+    table = torch.zeros(rows.shape[0], stride, dtype=torch.int64, device=rows.device)
+    table[:, 0] = nruns
+    table[:, 1:] = (pattern | (length << 4))[:, :stride - 1]
+    return table.to(torch.int16).contiguous()
+
+
+def build(scales, n, k, geometry):
+    """The run table of one weight (tagged scale bytes [n, k/16]) for a kernel of the given runs geometry."""
+    return run_table(warp_patterns(block_flags(scales, n, k), n, k, **geometry))
+
+
+def reference_table(pat):
+    """The same table by a plain loop (tests)."""
+    panels, warps_m, k_tiles = pat.shape
+    lists = []
+    for row in pat.reshape(panels * warps_m, k_tiles).tolist():
+        runs = []
+        for p in row:
+            if runs and runs[-1][0] == p:
+                runs[-1][1] += 1
+            else:
+                runs.append([p, 1])
+        lists.append(runs)
+    stride = 1 + max(len(r) for r in lists)
+    out = torch.zeros(len(lists), stride, dtype=torch.int64)
+    for i, runs in enumerate(lists):
+        out[i, 0] = len(runs)
+        for j, (p, length) in enumerate(runs):
+            out[i, 1 + j] = p | (length << 4)
+    return out.to(torch.int16)
