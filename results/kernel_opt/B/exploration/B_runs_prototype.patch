+#!/usr/bin/env python3
+"""Kernel-opt amendment 5 (B), measurement C2: the 4096^3 breakdown, the per-k_tile dispatch vs per-warp run tables.
+
+    python experiments/kernel_opt/c2_runs.py --b-root DIR --freq-root DIR --a1-root DIR --out JSON
+
+Operands as C2 / C2' / C2'': weights N(0, 0.02) seed 4096, 4096 tokens N(0, 1) FourOverSix per token.
+16x64 tags (the joint (warp, k_tile) pattern is bit g + 2 kb):
+  e2m1     all E2M1 (pattern 0 everywhere: the fixed cost)
+  real     model.layers.0.self_attn.o_proj of the Llama-3.1-8B TC 16x64 map (typical)
+  densest  the Llama-3.1-8B o_proj with the most E0M3 tiles (worst tags)
+  p1 / p5  pattern 1 / 5 everywhere (one run per warp, a non-zero arm)
+  alt      patterns 0 and 1 alternating along K (a run per k_tile: the table's worst case)
+  e0m3     all E0M3
+256x64 tags: all E2M1, the real 256x64 map of the same layer, all E0M3.
+Configurations (GEMM only, the 128-wide builds):
+  stock_wA, nodisp                  C2's references (sm120/build)
+  default_{tag}, freq_{tag}         n16k64_wA from sm120/build (16 arms) and from --freq-root (#2)
+  B_{tag}                           n16k64_wA_rt from --b-root with the weight's run table
+  g32_{tag}, B256_{tag}             n16k64_wA_g32 from --a1-root (A') and n16k64_wA_g32_rt with its table (256x64 tags)
+Modes as c2_freq.py: b2b, isolated, sustained; 3 rotated rounds each.
+Check before timing: every B / freq output equals its default's (and B256's its g32's) bitwise.
+"""
+import argparse
+import statistics
+import sys
+import time
+from pathlib import Path
+
+import torch
+from torch.profiler import ProfilerActivity, profile
+
+REPO = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO / 'experiments' / 'kernel_opt'))
+sys.path.insert(0, str(REPO / 'sm120'))
+sys.path.insert(0, str(REPO / 'sm120' / 'bench'))
+import common as B  # noqa: E402
+from c2_freq import Sampler, gemm_times  # noqa: E402
+from mixfp4_sm120 import mapio  # noqa: E402
+from mixfp4_sm120 import numerics as N  # noqa: E402
+from mixfp4_sm120 import runs as RT  # noqa: E402
+from mixfp4_sm120.lib import Kernel  # noqa: E402
+from mixfp4_sm120.linear import place_scales as place  # noqa: E402
+
+LAYER = 'model.layers.0.self_attn.o_proj'
+ART = Path('/home/dev/n16k64_campaign/paper/artifacts')
+TAGS16 = ('e2m1', 'real', 'densest', 'p1', 'p5', 'alt', 'e0m3')
+TAGS256 = ('e2m1', 'real', 'e0m3')
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument('--b-root', required=True)
+    ap.add_argument('--freq-root', required=True)
+    ap.add_argument('--a1-root', required=True)
+    ap.add_argument('--rounds', type=int, default=3)
+    ap.add_argument('--out', type=Path, required=True)
+    args = ap.parse_args()
+    B.require_idle()
+    n = k = t = 4096
+    g = torch.Generator('cpu').manual_seed(4096)
+    w = (torch.randn(n, k, generator=g) * 0.02).cuda().bfloat16()
+    x = torch.randn(t, k, generator=g).cuda().bfloat16()
+    xn, xsb, gsx = N.quantize_act(x, 'four_over_six_rows')
+    xp, xsf = N.pack_nibbles(xn), place(xsb, k)
+    h16, m16, _ = mapio.read_map(ART / 'llama8b_tc_16x64.mixfp4map')
+    _, m256, _ = mapio.read_map(ART / 'llama8b_tc_256x64.mixfp4map')
+    grid = (n // 16, k // 64)
+    blk = torch.arange(grid[0])[:, None] % 8
+    kbl = torch.arange(grid[1])[None, :] % 2
+    ktl = torch.arange(grid[1])[None, :] // 2
+    dense = max((m for m in h16['modules'] if m['name'].endswith('o_proj')), key=lambda m: m['selected'])
+    maps16 = dict(e2m1=torch.zeros(grid, dtype=torch.bool), real=m16[LAYER], densest=m16[dense['name']],
+                  p1=((blk < 4) & (kbl == 0)).expand(grid).clone(), p5=(blk < 4).expand(grid).clone(),
+                  alt=((blk < 4) & (kbl == 0) & (ktl % 2 == 1)).expand(grid).clone(), e0m3=torch.ones(grid, dtype=torch.bool))
+    maps256 = dict(e2m1=torch.zeros(grid, dtype=torch.bool), real=m256[LAYER], e0m3=torch.ones(grid, dtype=torch.bool))
+    K = dict(stock=Kernel.load('stock_wA'), nodisp=Kernel.load('n16k64_wA_nodisp'), default=Kernel.load('n16k64_wA'),
+             freq=Kernel.load('n16k64_wA', build_root=args.freq_root), B=Kernel.load('n16k64_wA_rt', build_root=args.b_root),
+             g32=Kernel.load('n16k64_wA_g32', build_root=args.a1_root),
+             B256=Kernel.load('n16k64_wA_g32_rt', build_root=args.b_root))
+    assert K['B'].runs and K['B256'].runs and not K['default'].runs
+
+    def wt(kind, mask=None):
+        wn, wsb, gsw = N.quantize_weight(w, kind, mask, (16, 64) if mask is not None else None)
+        return N.pack_nibbles(wn), place(wsb, k), float(gsw), wsb
+
+    def call(kk, wts, runs=None):
+        wp, wsf, gsw, _ = wts
+        kern = K[kk]
+        return lambda: kern.gemm(wp, wsf, xp, xsf, n, t, k, scale_m_default=gsw, scale_n=gsx, check=False, runs=runs)
+    calls, pairs, info = {}, [], {}
+    calls['stock_wA'] = call('stock', wt('nvfp4'))
+    calls['nodisp'] = call('nodisp', wt('four_over_six'))
+    for tg, m in maps16.items():
+        wts = wt('map', m)
+        table = RT.build(wts[3], n, k, K['B'].runs_geometry).cuda()
+        info[f'16x64 {tg}'] = dict(e0m3_tiles=int(m.sum()), max_runs_per_warp=int(table[:, 0].max()),
+                                   mean_runs_per_warp=float(table[:, 0].float().mean()))
+        for kk in ('default', 'freq'):
+            calls[f'{kk}_{tg}'] = call(kk, wts)
+        calls[f'B_{tg}'] = call('B', wts, table)
+        pairs += [(f'default_{tg}', f'freq_{tg}'), (f'default_{tg}', f'B_{tg}')]
+    for tg, m in maps256.items():
+        wts = wt('map', m)
+        table = RT.build(wts[3], n, k, K['B256'].runs_geometry).cuda()
+        info[f'256x64 {tg}'] = dict(e0m3_tiles=int(m.sum()), max_runs_per_warp=int(table[:, 0].max()),
+                                    mean_runs_per_warp=float(table[:, 0].float().mean()))
+        calls[f'g32_{tg}'] = call('g32', wts)
+        calls[f'B256_{tg}'] = call('B256', wts, table)
+        pairs.append((f'g32_{tg}', f'B256_{tg}'))
+    res = dict(protocol="results/kernel_opt/PROTOCOL.md, amendment 5 (B, C2)", gpu=B.gpu_info(), size=4096,
+               densest_module=dense['name'], runs=info,
+               kernels={kk: dict(sha256=v.sha256, root=str(Path(v.path).parent.parent)) for kk, v in K.items()},
+               checks={}, modes={})
+    for a, b in pairs:
+        ya, yb = calls[a](), calls[b]()
+        torch.cuda.synchronize()
+        ok = bool(torch.equal(ya.view(torch.int16), yb.view(torch.int16)))
+        res['checks'][f'{b} == {a}'] = ok
+        if not ok:
+            B.write(args.out, res)
+            raise SystemExit(f'{b} differs from {a}')
+    names = list(calls)
+    for mode in ('b2b', 'isolated', 'sustained'):
+        per = {nm: [] for nm in names}
+        tel = {nm: [] for nm in names}
+        for r in range(args.rounds):
+            shift = (r * len(names) // args.rounds) % len(names)
+            for nm in names[shift:] + names[:shift]:
+                fn = calls[nm]
+                fn()
+                torch.cuda.synchronize()
+                if mode == 'b2b':
+                    with profile(activities=[ProfilerActivity.CUDA]) as prof:
+                        for _ in range(20):
+                            fn()
+                        torch.cuda.synchronize()
+                    per[nm].append(statistics.median(gemm_times(prof)))
+                elif mode == 'isolated':
+                    iso = []
+                    for _ in range(15):
+                        time.sleep(0.05)
+                        with profile(activities=[ProfilerActivity.CUDA]) as prof:
+                            fn()
+                            torch.cuda.synchronize()
+                        iso += gemm_times(prof)
+                    per[nm].append(statistics.median(iso))
+                else:
+                    evs = []
+                    with Sampler() as smp:
+                        t0 = time.time()
+                        half, end = t0 + 1.0, t0 + 2.0
+                        while time.time() < end:
+                            e0_, e1_ = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                            e0_.record()
+                            fn()
+                            e1_.record()
+                            evs.append((time.time(), e0_, e1_))
+                            if len(evs) % 64 == 0:
+                                torch.cuda.synchronize()
+                        torch.cuda.synchronize()
+                    per[nm].append(statistics.median(a.elapsed_time(b) * 1e3 for (tt, a, b) in evs if tt >= half))
+                    tel[nm].append(smp.summary(half))
+                print(f'{mode} r{r} {nm:16s} {per[nm][-1]:8.1f} us', flush=True)
+        res['modes'][mode] = {nm: dict(us=statistics.median(per[nm]), rounds=per[nm], telemetry=tel[nm]) for nm in names}
+        B.write(args.out, res)
+    summ = {}
+    for mode, d in res['modes'].items():
+        u = {nm: v['us'] for nm, v in d.items()}
+        s = {}
+        for tg in TAGS16:
+            s[f'B vs default, {tg}'] = 100 * (u[f'B_{tg}'] / u[f'default_{tg}'] - 1)
+            s[f'B vs freq, {tg}'] = 100 * (u[f'B_{tg}'] / u[f'freq_{tg}'] - 1)
+            s[f'B_{tg} vs nodisp'] = 100 * (u[f'B_{tg}'] / u['nodisp'] - 1)
+            s[f'B_{tg} vs stock_wA'] = 100 * (u[f'B_{tg}'] / u['stock_wA'] - 1)
+        for tg in TAGS256:
+            s[f'B256 vs g32, {tg}'] = 100 * (u[f'B256_{tg}'] / u[f'g32_{tg}'] - 1)
+            s[f'B256_{tg} vs stock_wA'] = 100 * (u[f'B256_{tg}'] / u['stock_wA'] - 1)
+        s['nodisp vs stock_wA'] = 100 * (u['nodisp'] / u['stock_wA'] - 1)
+        summ[mode] = s
+    res['summary'] = summ
+    res['status'] = 'complete'
+    B.write(args.out, res)
+    for mode, s in summ.items():
+        print(mode, ' '.join(f'{k_}={v:+.2f}%' for k_, v in s.items() if k_.startswith('B vs default') or k_.startswith('B256 vs')))
+
+
+if __name__ == '__main__':
+    main()
