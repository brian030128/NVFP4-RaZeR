diff --git a/sm120/mixfp4_sm120/zbits.py b/sm120/mixfp4_sm120/zbits.py
new file mode 100644
index 0000000..ed39323
--- /dev/null
+++ b/sm120/mixfp4_sm120/zbits.py
@@ -0,0 +1,77 @@
+"""kernel-opt B': per-warp all-E2M1 bits for the weights-on-A mixed kernels built with MIXFP4_ZEROBIT.
+
+The mixed mainloop dispatches every k_tile on a pattern of E0M3 flags that each warp reads from its operands (bit
+g + a_gran * kb for granule g of the warp's m-atoms and k_block kb of the k_tile). With the bits, a warp instead tests
+one bit per k_tile: 0 means the pattern is 0 (every granule E2M1), and the kernel runs arm 0's body without reading a
+flag; 1 means it reads the flags and dispatches among the other arms (the collective's MIXFP4_ZEROBIT hook). The bits
+are built here, once per weight, from the same tags, so every k_tile still executes the MMAs of its own pattern.
+
+Geometry (all widths of the n16k64_wA family share it; `Kernel.zbits_geometry`): a CTA covers tile_m = 128 weight rows
+(one "panel"); warp row w of warps_m = 4 owns m-atoms m = 0 .. mma_m - 1 at the 16-row blocks m * warps_m + w of the
+panel; a granule is a_atoms consecutive m-atoms and takes its first atom's flag; k_tiles are 128 wide (two 64-wide
+k_blocks). Rows past n and k_blocks past K read as E2M1 (the TMA zero fill).
+
+Rows: int32 [panels * warps_m, stride] (uint32 bit patterns), row p * warps_m + w; bit kt % 32 of word kt // 32 is
+(pattern of that warp at k_tile kt) != 0. stride = ceil(k_tiles / 32) + 1: the kernel reads one word ahead.
+"""
+import torch
+
+from . import numerics as N
+
+K_TILE = 128
+
+
+def block_flags(scales, n, k):
+    """bool [n/16 (rounded up), k/64]: the E0M3 tag of every 16-row x 64-column tile, from the tagged scale bytes
+    [n, k/16] (bit 7). The tag the kernel reads is the tile's first scale byte (tags are uniform over 16x64 tiles)."""
+    rows16 = -(-n // 16)
+    f = (scales[::16, ::64 // N.SCALE_BLOCK] >> 7).to(torch.bool)
+    assert tuple(f.shape) == (rows16, -(-k // 64)), (tuple(f.shape), n, k)
+    return f
+
+
+def warp_patterns(flags16, n, k, warps_m=4, mma_m=2, a_atoms=1, tile_m=128):
+    """int64 [panels, warps_m, k_tiles]: the joint pattern each warp's dispatch reads at each k_tile."""
+    blocks = tile_m // 16
+    assert blocks == warps_m * mma_m and mma_m % a_atoms == 0, (tile_m, warps_m, mma_m, a_atoms)
+    panels = -(-n // tile_m)
+    k_tiles = -(-k // K_TILE)
+    f = torch.zeros(panels * blocks, k_tiles * 2, dtype=torch.int64, device=flags16.device)
+    f[:flags16.shape[0], :flags16.shape[1]] = flags16.to(torch.int64)
+    f = f.view(panels, mma_m, warps_m, k_tiles, 2)             # 16-row block m * warps_m + w = m-atom m of warp row w
+    a_gran = mma_m // a_atoms
+    pat = torch.zeros(panels, warps_m, k_tiles, dtype=torch.int64, device=flags16.device)
+    for g in range(a_gran):
+        for kb in range(2):
+            pat |= f[:, g * a_atoms, :, :, kb] << (g + a_gran * kb)
+    return pat
+
+
+def bit_rows(pat):
+    """int32 [panels * warps_m, ceil(k_tiles / 32) + 1] rows of a warp_patterns tensor (see the module docstring)."""
+    panels, warps_m, k_tiles = pat.shape
+    rows = panels * warps_m
+    words = -(-k_tiles // 32) + 1
+    bits = torch.zeros(rows, words * 32, dtype=torch.int64, device=pat.device)
+    bits[:, :k_tiles] = (pat != 0).reshape(rows, k_tiles).to(torch.int64)
+    w = (bits.view(rows, words, 32) << torch.arange(32, device=pat.device)).sum(-1)
+    return torch.where(w >= 2 ** 31, w - 2 ** 32, w).to(torch.int32).contiguous()
+
+
+def build(scales, n, k, geometry):
+    """The bit rows of one weight (tagged scale bytes [n, k/16]) for a kernel of the given geometry."""
+    return bit_rows(warp_patterns(block_flags(scales, n, k), n, k, **geometry))
+
+
+def reference_rows(pat):
+    """The same rows by a plain loop (tests)."""
+    panels, warps_m, k_tiles = pat.shape
+    words = -(-k_tiles // 32) + 1
+    out = []
+    for row in pat.reshape(panels * warps_m, k_tiles).tolist():
+        ws = [0] * words
+        for kt, p in enumerate(row):
+            if p:
+                ws[kt // 32] |= 1 << (kt % 32)
+        out.append([w - 2 ** 32 if w >= 2 ** 31 else w for w in ws])
+    return torch.tensor(out, dtype=torch.int32)
diff --git a/sm120/tests/test_zbits.py b/sm120/tests/test_zbits.py
new file mode 100644
index 0000000..7ce22ae
--- /dev/null
+++ b/sm120/tests/test_zbits.py
@@ -0,0 +1,74 @@
+"""kernel-opt B': the per-warp all-E2M1 bits (MIXFP4_ZEROBIT builds, mixfp4_sm120/zbits.py).
+
+- the packed bit rows equal a plain-loop reference, and bit kt is set exactly when the warp's pattern is non-zero;
+- every B' build computes its base build's output bit for bit, with the bits (fused, unfused) and without them (the
+  kernel's pipelined fallback), on random maps of every density, partial row panels and K not a multiple of 128;
+- negative control: all-zero bits on a map with E0M3 tiles must change the output (the bits are what the kernel uses).
+"""
+import pytest
+import torch
+
+from mixfp4_sm120 import zbits as ZB
+from mixfp4_sm120.artifact import pack_module
+from mixfp4_sm120.lib import Kernel
+from mixfp4_sm120.linear import NativeLinear
+
+ZB_BUILDS = {'n16k64_wA_n16_t0_zb': 'n16k64_wA_n16_t0', 'n16k64_wA_n32_t0_zb': 'n16k64_wA_n32_t0',
+             'n16k64_wA_n64_t0_zb': 'n16k64_wA_n64_t0', 'n16k64_wA_e64_t0_zb': 'n16k64_wA_e64_t0'}
+SHAPES = [(1, 4096, 4096), (19, 1024, 4096), (77, 2560, 9728), (300, 48, 2560), (1000, 4096, 1024), (64, 640, 320)]
+
+
+def kernel(name):
+    try:
+        return Kernel.load(name)
+    except Exception as e:  # noqa: BLE001
+        pytest.skip(f'{name} not built: {e}')
+
+
+@pytest.mark.parametrize('seed', range(5))
+def test_bit_rows_reference(seed):
+    g = torch.Generator().manual_seed(seed)
+    pat = (torch.rand(3, 4, 37 + 31 * seed, generator=g) < 0.2).to(torch.int64) * torch.randint(1, 16, (1,), generator=g)
+    rows = ZB.bit_rows(pat)
+    assert torch.equal(rows, ZB.reference_rows(pat))
+    assert rows.shape == (12, -(-pat.shape[2] // 32) + 1)
+    assert not rows[:, -1].any()                          # the read-ahead word is padding
+
+
+@pytest.mark.gpu
+@pytest.mark.parametrize('name', sorted(ZB_BUILDS))
+@pytest.mark.parametrize('t,n,k', SHAPES)
+@pytest.mark.parametrize('frac', [0.0, 0.1, 0.5, 1.0])
+def test_bitwise_equal_to_base(device, name, t, n, k, frac):
+    zk, base = kernel(name), kernel(ZB_BUILDS[name])
+    assert zk.zbits and not base.zbits
+    g = torch.Generator(device='cpu').manual_seed(t + n + k + int(100 * frac))
+    w = (torch.randn(n, k, generator=g) * 0.02).cuda().bfloat16()
+    mask = torch.rand(-(-n // 16), k // 64, generator=g) < frac
+    pw = pack_module('m', w, None, 'map', mask, (16, 64))
+    x = torch.randn(t, k, generator=g).cuda().bfloat16()
+    ref = NativeLinear(pw, base, 'four_over_six_rows', 'm')(x)
+    lin = NativeLinear(pw, zk, 'four_over_six_rows', 'm')
+    assert lin.zbits is not None
+    assert torch.equal(lin(x), ref)                       # fused, with the bits
+    lin.fused = False
+    assert torch.equal(lin(x), ref)                       # unfused, with the bits
+    lin.zbits = None
+    assert torch.equal(lin(x), ref)                       # the kernel's pipelined fallback (no bits)
+
+
+@pytest.mark.gpu
+@pytest.mark.parametrize('name', sorted(ZB_BUILDS))
+def test_negative_control(device, name):
+    zk = kernel(name)
+    n, k, t = 1024, 4096, 64
+    g = torch.Generator(device='cpu').manual_seed(7)
+    w = (torch.randn(n, k, generator=g) * 0.02).cuda().bfloat16()
+    mask = torch.rand(n // 16, k // 64, generator=g) < 0.5
+    pw = pack_module('m', w, None, 'map', mask, (16, 64))
+    x = torch.randn(t, k, generator=g).cuda().bfloat16()
+    lin = NativeLinear(pw, zk, 'four_over_six_rows', 'm')
+    good = lin(x)
+    assert lin.zbits.any()
+    lin.zbits = torch.zeros_like(lin.zbits)               # claims every k_tile is all-E2M1: E0M3 tiles run as E2M1
+    assert not torch.equal(lin(x), good)
